# Gemini API Key (Google AI Studio에서 발급)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenWeather API Key
OPENWEATHER_API_KEY=your_openweather_api_key_here

# 데모 모드: true이면 외부 API 키가 없어도 목업 응답으로 동작
DEMO_MODE=true

# 데이터베이스 (기본값: SQLite 파일)
DATABASE_URL=sqlite:///./ginseng_farm.db

# 업로드 파일 저장 경로
UPLOAD_DIR=./uploads
